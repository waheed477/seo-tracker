{
  "name": "seo-operating-system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node --watch server/index.js",
    "dev:frontend": "cd frontend && ./node_modules/.bin/vite --port 5000 --host 0.0.0.0",
    "build": "cd frontend && npm run build",
    "start": "cd backend && node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
