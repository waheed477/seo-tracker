# Production environment for the frontend.
#
# VITE_API_URL controls where the frontend sends API requests.
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DOCKER (Hugging Face Spaces):                                             │
# │   Leave EMPTY — the backend serves both the API and the built frontend    │
# │   from the same origin, so the relative /api fallback works correctly.    │
# │                                                                           │
# │ NETLIFY / VERCEL (frontend hosted separately):                             │
# │   Set VITE_API_URL to the full backend URL including /api prefix, e.g.    │
# │   VITE_API_URL=https://your-space-name.hf.space/api                      │
# │   Do this in the Netlify/Vercel UI — environment variables set there      │
# │   override this file at build time.                                       │
# └─────────────────────────────────────────────────────────────────────────────┘
VITE_API_URL=
