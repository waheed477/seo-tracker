# ── Node modules (installed in Docker, never copy from host) ────────────────
backend/node_modules/
frontend/node_modules/

# ── Build output (built in Docker, never copy from host) ────────────────────
frontend/dist/

# ── Environment files (contain secrets — never copy into image) ─────────────
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!frontend/.env.production
!backend/.env.example
!frontend/.env.example

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Coverage / cache ────────────────────────────────────────────────────────
coverage/
.cache/
.mypy_cache/
.turbo/

# ── Git ─────────────────────────────────────────────────────────────────────
.git/
