# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values for local development.

# ── Required ──────────────────────────────────────────────────────────────────
# The server will refuse to start without these.
MONGO_URI=mongodb://localhost:27017/seo-os
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=gsk_...
SITE_ENCRYPTION_KEY=replace-with-a-32-byte-random-key

# ── Optional ──────────────────────────────────────────────────────────────────
# Backend port (default 5001; use 5001 locally so it doesn't clash with Vite)
PORT=5001

# ── Google Search Console (required for rank tracking) ────────────────────────
# Register these in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# This must be ONE fixed URI (no site id in the path) — Google OAuth requires an
# exact, pre-registered redirect URI. The siteId is carried in a signed `state` param.
# Redirect URI for local dev: http://localhost:5001/api/gsc/callback
# Redirect URI for production: https://your-space-name.hf.space/api/gsc/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/gsc/callback

# ── Stripe Billing (TEST MODE) ────────────────────────────────────────────────
# Get these from your Stripe Dashboard → Test mode → Developers → API keys / Webhooks
# STRIPE_SECRET_KEY starts with sk_test_...
# STRIPE_WEBHOOK_SECRET starts with whsec_...
# STRIPE_PRICE_ID_PRO starts with price_...
# These are test-mode keys — no real payments are processed.
STRIPE_SECRET_KEY=sk_test_replace-with-your-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-secret
STRIPE_PRICE_ID_PRO=price_replace-with-your-pro-price-id
# ── Email provider (Resend) ─────────────────────────────────────────────────
# Required for password reset emails in environments without SMTP.
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@seoos.app
# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In local dev, defaults to http://localhost:5000 (Vite proxy).
# In production, set to the deployed frontend URL.
FRONTEND_URL=http://localhost:5000

# ── Production only ──────────────────────────────────────────────────────────
# Set to "production" when deploying. Controls static file serving and CORS.
# Also switches the auth cookies to Secure (leave unset locally, or the browser
# will silently refuse to store them over plain http://localhost).
# NODE_ENV=production

# ── Auth cookies: cross-site deployments ─────────────────────────────────────
# Only needed when the frontend is served from a DIFFERENT registrable domain
# than this API (e.g. frontend on netlify.app, backend on hf.space). Browsers
# will not send SameSite=Lax cookies on such cross-site requests, so the session
# can never re-hydrate. Setting this to "true" switches the auth cookies to
# SameSite=None and forces Secure (required by browsers, so HTTPS only).
# Leave unset for local dev and for same-origin deploys (the Docker image serves
# the frontend and API from one origin) — SameSite=Lax is the safer default.
# COOKIE_CROSS_SITE=true
