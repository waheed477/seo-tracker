# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values for local development.

# ── Required ──────────────────────────────────────────────────────────────────
# The server will refuse to start without these.
MONGO_URI=mongodb://localhost:27017/seo-os
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=gsk_...
SITE_ENCRYPTION_KEY=replace-with-a-32-byte-random-key

# ── Optional ──────────────────────────────────────────────────────────────────
# Backend port (default 5000; use 5001 locally so it doesn't clash with Vite)
PORT=5001

# ── Google Search Console (required for rank tracking) ────────────────────────
# Register these in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Redirect URI for local dev: http://localhost:5001/api/sites/SITE_ID/gsc/callback
# Redirect URI for production: https://your-space-name.hf.space/api/sites/SITE_ID/gsc/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/sites/SITE_ID/gsc/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In local dev, defaults to http://localhost:5000 (Vite proxy).
# In production, set to the deployed frontend URL.
FRONTEND_URL=http://localhost:5000

# ── Production only ──────────────────────────────────────────────────────────
# Set to "production" when deploying. Controls static file serving and CORS.
# NODE_ENV=production
